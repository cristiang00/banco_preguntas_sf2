# =========================================================================
# Variables de Entorno - Banco de Preguntas Saber Pro (Sistema Distribuido)
# =========================================================================

# Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Broker de Mensajería RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Seguridad y Autenticación Keycloak / OpenID Connect (Sprint 3 - HU7)
KEYCLOAK_URL=http://localhost:8089
KEYCLOAK_REALM=saberpro
KEYCLOAK_CLIENT_ID=gateway-client
KEYCLOAK_CLIENT_SECRET=saberpro-client-secret-2026
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/saberpro/protocol/openid-connect/certs
KEYCLOAK_ISSUER_URI=http://localhost:8089/realms/saberpro

# Proveedor de Correo en Notification Service (mock / smtp)
NOTIFICATION_EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notificaciones@unicauca.edu.co

# URLs de Microservicios para API Gateway
USERS_SERVICE_URL=http://localhost:8081
QUESTIONS_SERVICE_URL=http://localhost:8082
VALIDATION_SERVICE_URL=http://localhost:8083
LIFECYCLE_SERVICE_URL=http://localhost:8084
REVIEW_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086
AUDIT_SERVICE_URL=http://localhost:8087

# URL de API Gateway para el Cliente Frontend Swing
GATEWAY_URL=http://localhost:8080/api/v1
