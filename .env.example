# =========================================================================
# Variables de Entorno - Banco de Preguntas Saber Pro (Sistema Distribuido)
# =========================================================================

# Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Broker de Mensajería RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Seguridad y Autenticación JWT
JWT_SECRET=SaberProSecretKey2026SuperSecureMustBeAtLeast256BitsLongForHMACSHA256
JWT_EXPIRATION_MS=86400000

# Proveedor de Correo en Notification Service (mock / smtp)
NOTIFICATION_EMAIL_PROVIDER=mock

# URLs de Microservicios para API Gateway
USERS_SERVICE_URL=http://localhost:8081
QUESTIONS_SERVICE_URL=http://localhost:8082
VALIDATION_SERVICE_URL=http://localhost:8083
LIFECYCLE_SERVICE_URL=http://localhost:8084
REVIEW_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086
AUDIT_SERVICE_URL=http://localhost:8087

# URL de API Gateway para el Cliente Frontend
GATEWAY_URL=http://localhost:8080/api/v1

